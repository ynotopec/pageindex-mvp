# PageIndex cloud mode. Leave empty for local self-hosted PageIndex.
PAGEINDEX_API_KEY=

# Local PageIndex settings. PAGEINDEX_MODEL builds the index;
# PAGEINDEX_RETRIEVE_MODEL powers the agentic collection.query(...) step.
# Leave empty to use PageIndex defaults.
# Syntaxe .env recommandée: pas de guillemets autour des valeurs.
# (L'app tolère les quotes externes et les retire automatiquement si présentes.)
OPENAI_API_KEY=
# URL du serveur LLM OpenAI-compatible (OpenAI, vLLM, Ollama /v1, LiteLLM proxy, etc.).
OPENAI_BASE_URL=https://api.openai.com/v1
# Alias aussi renseigné par l'app au runtime pour LiteLLM/anciens clients.
#OPENAI_API_BASE=https://api.openai.com/v1
# Désactivé par défaut: évite les erreurs 401 de trace export avec clés Ollama/vLLM/non-OpenAI.
OPENAI_AGENTS_DISABLE_TRACING=1
# Normalisation alignée sur PageIndex dev: PAGEINDEX_MODEL est passé tel quel
# à LiteLLM pour l’indexation; PAGEINDEX_RETRIEVE_MODEL garde gpt-4o-mini/openai/.../litellm/...
# inchangés, et transforme ollama_chat/... ou vllm/... en litellm/ollama_chat/... ou litellm/vllm/... .
PAGEINDEX_MODEL=openai/gpt-4o-mini
PAGEINDEX_RETRIEVE_MODEL=openai/gpt-4o-mini
PAGEINDEX_COLLECTION=default
PAGEINDEX_WORKSPACE=.pageindex_workspace

# Optional/default Streamlit bind values. Positional run.sh arguments override these.
#SERVER_NAME=0.0.0.0
#SERVER_PORT=8501

# Optional/default UI settings.
#PAGEINDEX_STREAMING=false
#PAGEINDEX_SHOW_TRACES=false

# Optional/default for DGX Spark, H100, or other CUDA hosts to choose visible GPUs.
#CUDA_VISIBLE_DEVICES=0

# PageIndex dev IndexConfig defaults (local mode only).
#PAGEINDEX_TOC_CHECK_PAGE_NUM=20
#PAGEINDEX_MAX_PAGE_NUM_EACH_NODE=10
#PAGEINDEX_MAX_TOKEN_NUM_EACH_NODE=20000
#PAGEINDEX_IF_ADD_NODE_ID=true
#PAGEINDEX_IF_ADD_NODE_SUMMARY=true
#PAGEINDEX_IF_ADD_DOC_DESCRIPTION=true
#PAGEINDEX_IF_ADD_NODE_TEXT=false
