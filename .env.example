# PageIndex cloud mode. Leave empty for local self-hosted PageIndex.
PAGEINDEX_API_KEY=

# Local PageIndex settings. PAGEINDEX_MODEL builds the index;
# PAGEINDEX_RETRIEVE_MODEL powers the agentic collection.query(...) step.
# Leave empty to use PageIndex defaults.
OPENAI_API_KEY=
PAGEINDEX_MODEL=gpt-4o-2024-11-20
PAGEINDEX_RETRIEVE_MODEL=gpt-4o-2024-11-20
PAGEINDEX_COLLECTION=default
PAGEINDEX_WORKSPACE=.pageindex_workspace

# Optional/default Streamlit bind values. Positional run.sh arguments override these.
#SERVER_NAME=0.0.0.0
#SERVER_PORT=8501

# Optional/default UI settings.
#PAGEINDEX_SHOW_TRACES=false

# Optional/default for DGX Spark, H100, or other CUDA hosts to choose visible GPUs.
#CUDA_VISIBLE_DEVICES=0
