# Provider: ollama (local, tokenless) or openai_compatible (OpenAI / vLLM / TGI-compatible chat completions).
LLM_PROVIDER=ollama

# Ollama defaults. Good for local GPU boxes if Ollama is listening on localhost.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gpt-oss

# Required only when LLM_PROVIDER=openai_compatible.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
PAGEINDEX_MODEL=openai/ai-multilingual
PAGEINDEX_RETRIEVE_MODEL=openai/ai-multilingual

# Optional/default Streamlit bind values. Positional run.sh arguments override these.
#SERVER_NAME=0.0.0.0
#SERVER_PORT=8501

# Optional/default retrieval and generation settings.
#TOP_K=4
#CHUNK_MAX_CHARS=1800
#CHUNK_OVERLAP=200
#LLM_TEMPERATURE=0
#LLM_MAX_TOKENS=1024

# Optional/default for DGX Spark, H100, or other CUDA hosts to choose visible GPUs.
#CUDA_VISIBLE_DEVICES=0

#HYBRID_LEXICAL_TOP_K=12
#MAX_CONTEXT_CHARS=50000
